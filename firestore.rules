rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: get user role from users collection
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuth() && getUserRole() == 'admin';
    }

    // Events - any authenticated user can read
    match /events/{eventId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Participants - authenticated users can read, admins can write
    match /participants/{participantId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    // Tables and seats
    match /tables/{tableId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /seats/{seatId} {
      allow read: if isAuth();
      allow write: if isAuth(); // Scanners may need to update during check-in
    }

    // Check-in log - any auth user can read and create
    match /checkInLog/{logId} {
      allow read: if isAuth();
      allow create: if isAuth();
    }

    // Users collection - admins can read all, users can read own
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Config - admins only
    match /config/{configId} {
      allow read, write: if isAdmin();
    }
  }
}
